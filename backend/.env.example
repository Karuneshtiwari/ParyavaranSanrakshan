# ==============================================================
# ParyavaranSanrakshan - Backend Environment Configuration Template
# Copy this file to backend/.env and populate with your credentials.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================

# Database - Neon PostgreSQL
DATABASE_URL=postgresql://username:password@ep-your-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_random_key_here
JWT_EXPIRE_MINUTES=1440

# Cloudinary - Image & Media Cloud Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP - Gmail OTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=ParyavaranSanrakshan

# OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Admin Seed Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourAdminSecurePassword123!
ADMIN_NAME=System Administrator

# Application
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# File Upload Boundaries
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# Cloudinary Folders
CLOUDINARY_WASTE_FOLDER=paryavaran_sanrakshan/waste_scans
CLOUDINARY_PROJECT_FOLDER=paryavaran_sanrakshan/project_media
